# Copy to .env and fill in. NEVER commit .env or share your token.

# Token from @BotFather (required)
BOT_TOKEN=

# Comma-separated numeric Telegram user IDs allowed to use admin commands.
# Leave empty to disable the admin interface entirely. Get your ID from @userinfobot.
ADMIN_IDS=

# SQLite file location (directory is created automatically)
DATABASE_PATH=data/bot.sqlite3

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Destination URL for all website buttons
WEBSITE_URL=https://www.netmark.ai/super

# If true, appends utm_source/utm_medium/utm_campaign to the button URL so the
# website's own analytics can attribute visits. Default false = exact URL.
UTM_ENABLED=false

# Broadcast speed in messages/second (must be > 0 and <= 30; Telegram's limit is ~30)
BROADCAST_RATE_PER_SECOND=20

# Shown in /privacy so users know who to contact (e.g. an email address).
OPERATOR_CONTACT=
